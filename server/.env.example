# Copy to .env (gitignored) and fill in.

# App-only bearer token from the X developer portal.
X_BEARER_TOKEN=

# The account whose mentions we listen for, without the @.
X_USERNAME=

# OAuth 1.0a consumer keys: identify the app.
TWITTER_CONSUMER_KEY=
TWITTER_CONSUMER_SECRET=

# OAuth 1.0a user tokens: identify the account we listen for.
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_TOKEN_SECRET=

# Local server settings. Optional; 3000 when unset.
PORT=3000
