.local/
node_modules/
package-lock.json

# A research run's output, when the repo itself is the working directory.
# Anchored on purpose: unanchored `digmore/` also matches plugin/skills/digmore/, which
# would keep the committed plugin build out of git entirely.
/digmore/

# server/ is a standalone service: it commits its own lock file, never its secrets.
!server/package-lock.json
server/.env
server/dist/
